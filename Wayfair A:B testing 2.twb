      <aliases enabled='yes' />
      <column caption='Return Rate' datatype='real' name='[Calculation_4768045376328867840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Returned_Qty]*100/[Purchased_Qty]' />
      </column>
      <column caption='Product Price' datatype='integer' name='[Calculation_5295810953221943296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Total_Order_Value]&#10;WHEN &quot;0 - 20&quot; THEN 10&#10;WHEN &quot;20 - 40&quot; THEN 30&#10;WHEN &quot;40 - 60&quot; THEN 50&#10;WHEN &quot;60 - 80&quot; THEN 70&#10;WHEN &quot;80 - 100&quot; THEN 90&#10;WHEN &quot;100 - 150&quot; THEN 125&#10;WHEN &quot;150 - 200&quot; THEN 175&#10;WHEN &quot;200 - 250&quot; THEN 225&#10;WHEN &quot;250 - 300&quot; THEN 275&#10;WHEN &quot;300 - 400&quot; THEN 350&#10;WHEN &quot;400 - 500&quot; THEN 450&#10;WHEN &quot;500 - 600&quot; THEN 550&#10;WHEN &quot;600 - 700&quot; THEN 650&#10;WHEN &quot;700 +&quot; THEN 700&#10;WHEN &quot;unknown&quot; THEN 0&#10;END' />
      </column>
      <column caption='Revenue' datatype='integer' name='[Calculation_5295810953223827457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Order_Product_ID]: SUM([Calculation_5295810953221943296]) * SUM([Purchased_Qty])}' />
      </column>
      <column caption='Revenue Per Item' datatype='real' name='[Calculation_5295810953231667202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5295810953223827457])/SUM([Purchased_Qty])' />
      </column>
      <column caption='Revenue Per Customer' datatype='real' name='[Calculation_5295810953232048131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5295810953223827457])/COUNTD([Customer_ID])' />
      </column>
      <column caption='Order Status' datatype='string' name='[Calculation_5844687162572623872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Cancelled] &gt; 0 THEN &quot;Cancelled&quot;&#10;ELSEIF [Returned_Qty] &gt; 0 THEN &quot;Returned&quot;&#10;ELSE &quot;Purchased&quot;&#10;END' />
      </column>
      <column caption='Customer Actual Delivery Date' datatype='datetime' name='[Customer_Actual_Delivery_Date]' role='dimension' type='ordinal' />
      <column caption='Customer Estimated Delivery Date' datatype='datetime' name='[Customer_Estimated_Delivery_Date]' role='dimension' type='ordinal' />
